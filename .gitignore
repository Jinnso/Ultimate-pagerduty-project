# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Archivo de variables con secretos (¡Muy importante!)
terraform.tfvars
*.auto.tfvars

# Ignore override files as they are usually used to override resources locally and not shared
override.tf
override.tf.json
*_override.tf
*_override.tf.json