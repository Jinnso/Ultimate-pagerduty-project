# PagerDuty API token
PAGERDUTY_API_KEY=your_pagerduty_api_key_here
# Datadog API credentials
DATADOG_API_KEY=your_datadog_api_key_here
DATADOG_APP_KEY=your_datadog_app_key_here
DATADOG_SITE=us5.datadoghq.com
# Grafana Cloud credentials
GRAFANA_API_KEY=your_grafana_api_key_here
GRAFANA_URL=https://your-instance.grafana.net
GRAFANA_FOLDER_UID=your_folder_uid_here
# Datadog integration key (for Cloud Reservation API) — from 'terraform output datadog_integration_key'
PAGERDUTY_EVENTS_KEY=your_datadog_integration_key_here
# Prometheus integration key (for IoT Local Key Controllers) — from 'terraform output grafana_prometheus_integration_key'
PAGERDUTY_IOT_EVENTS_KEY=your_prometheus_integration_key_here
